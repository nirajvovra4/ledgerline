# Copy to .env for local development (all values optional).
PORT=4000
HOST=0.0.0.0
DATABASE_PATH=./data/ledgerline.sqlite
# Pin "today" for deterministic screens (the demo seed is anchored to this date).
LEDGERLINE_TODAY=2026-06-30
# Seed the demo workspace automatically when the database is empty.
SEED_IF_EMPTY=true
